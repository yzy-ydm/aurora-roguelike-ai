# ==================================================
# Aurora-Roguelike-AI 服务端环境变量配置
# ==================================================
#
# 使用说明：
#   1. 复制此文件并重命名为 .env
#   2. 修改下面的配置值为你的实际配置
#   3. 不要将 .env 文件提交到Git
#
# 命令：
#   cp .env.example .env
# ==================================================

# ==================== 数据库配置 ====================
# MySQL数据库主机地址
MYSQL_HOST=localhost

# MySQL端口
MYSQL_PORT=3306

# MySQL用户名
MYSQL_USER=root

# MySQL密码（请修改为你的实际密码）
MYSQL_PASSWORD=your_password_here

# 数据库名称
MYSQL_DATABASE=aurora_game

# ==================== JWT认证配置 ====================
# JWT密钥（请修改为随机生成的密钥字符串）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# JWT算法
JWT_ALGORITHM=HS256

# Token过期时间（分钟，默认1440 = 24小时）
JWT_EXPIRE_MINUTES=1440

# ==================== 应用配置 ====================
# 应用运行环境：development / production
APP_ENV=development

# 调试模式：True / False
DEBUG=True

# 服务端口
APP_PORT=8000

# ==================== AI Provider配置 ====================
# AI_PROVIDER: agnes, mimo, mock, auto
# agnes: 调用Agnes AI (OpenAI兼容格式)
# mimo: 调用小米MiMo API (Anthropic格式)
# mock: 本地随机生成 (默认)
# auto: 尝试Agnes，失败则降级MiMo，再失败则Mock
AI_PROVIDER=mock

# ==================== Agnes AI配置 (OpenAI兼容) ====================
# Agnes API Key（请填入你的真实Key）
AGNES_API_KEY=your_agnes_api_key_here

# Agnes API基础地址
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Agnes模型名称
AGNES_MODEL=agnes-2.5-flash

# 可选配置
AGNES_MAX_TOKENS=4096
AGNES_TEMPERATURE=0.7
AGNES_TIMEOUT=120.0

# ==================== MiMo API配置 (保留作为降级) ====================
# MiMo API Key（请填入你的真实Key）
MIMO_API_KEY=tp-cf4dal6goppw7ftajdkp8468fxe9rhovv72boi7p250vnyt1

# MiMo模型名称
MIMO_MODEL=mimo-v2.5-pro

# MiMo API端点（Anthropic兼容接口）
MIMO_ENDPOINT=https://token-plan-cn.xiaomimimo.com/anthropic

# 可选配置
MIMO_MAX_TOKENS=4096
MIMO_TEMPERATURE=0.7
