# ==================================================
# 基于云端AI动态内容生成的Roguelike游戏系统
# 环境变量配置示例
# ==================================================
#
# 使用说明：
#   1. 复制此文件并重命名为 .env
#   2. 修改下面的配置值为你的实际配置
#   3. 不要将 .env 文件提交到Git
#
# 命令：
#   cp .env.example .env
# ==================================================

# ==================== 应用配置 ====================
# 应用运行环境：development / production
APP_ENV=development

# 调试模式：True / False
DEBUG=True

# 服务端口
APP_PORT=8000

# ==================== 数据库配置 ====================
# MySQL数据库连接地址
DB_HOST=localhost

# MySQL端口
DB_PORT=3306

# 数据库名称
DB_NAME=roguelike_game

# 数据库用户名
DB_USER=root

# 数据库密码（请修改为你的密码）
DB_PASSWORD=your_password_here

# 数据库连接字符串（自动生成，无需修改）
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==================== JWT认证配置 ====================
# JWT密钥（请修改为随机生成的密钥字符串）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# JWT算法
ALGORITHM=HS256

# Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== AI服务配置 ====================
# AI服务提供商：openai / azure / local
AI_PROVIDER=openai

# OpenAI API密钥（请修改为你的密钥）
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API地址（如使用代理或自定义地址）
OPENAI_API_BASE=https://api.openai.com/v1

# AI模型名称
AI_MODEL=gpt-3.5-turbo

# AI请求超时时间（秒）
AI_TIMEOUT=30

# AI最大重试次数
AI_MAX_RETRIES=3

# ==================== CORS配置 ====================
# 允许的跨域来源（多个用逗号分隔）
# 开发环境使用 *，生产环境请设置具体域名
CORS_ORIGINS=*

# ==================== 日志配置 ====================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# ==================== 安全配置 ====================
# 是否启用HTTPS（生产环境建议启用）
ENABLE_HTTPS=False

# SSL证书路径（启用HTTPS时配置）
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem
