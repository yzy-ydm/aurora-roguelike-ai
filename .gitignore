# ===========================================
# 基于云端AI动态内容生成的Roguelike游戏系统
# Git忽略规则配置
# ===========================================

# ==================== 系统文件 ====================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ==================== 编辑器/IDE ====================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.#*

# ==================== Python服务端 ====================
# 虚拟环境
server/venv/
server/.venv/
server/env/
server/.env/

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# 测试
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 类型检查
.mypy_cache/
.pytype/

# Jupyter Notebook
.ipynb_checkpoints

# 环境变量（包含敏感信息）
.env
*.env
.env.local
.env.production

# 日志文件
*.log
logs/

# ==================== Godot客户端 ====================
# Godot缓存目录
client/.godot/

# Godot导入缓存
client/.import/

# Godot导出模板
client/export_presets.cfg

# Godot临时文件
*.translation
*.uid

# Godot导入文件
*.import

